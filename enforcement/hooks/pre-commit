#!/usr/bin/env bash
set -euo pipefail

# SDD Pipeline Pre-Commit Hook — Comprehensive Gates
# Install: symlink this to .git/hooks/pre-commit
# Or run: ln -sf ../../enforcement/hooks/pre-commit .git/hooks/pre-commit

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

ERRORS=0
WARNINGS=0

log_error() { echo -e "${RED}[SDD Pipeline BLOCKED]${NC} $1"; ERRORS=$((ERRORS + 1)); }
log_warn()  { echo -e "${YELLOW}[SDD Pipeline WARNING]${NC} $1"; WARNINGS=$((WARNINGS + 1)); }
log_ok()    { echo -e "${GREEN}[SDD Pipeline OK]${NC} $1"; }

# NUL-delimited into an array (not a plain newline-joined string looped
# with unquoted `for file in $STAGED_FILES`) — the old form word-split on
# every space, so "my file.js" became two staged-file entries "my" and
# "file.js", neither of which exists, silently skipping real checks on
# any filename containing a space.
STAGED_FILES=()
while IFS= read -r -d '' f; do STAGED_FILES+=("$f"); done < <(git diff --cached --name-only --diff-filter=ACM -z)
STAGED_COUNT=${#STAGED_FILES[@]}

# Bash < 4.4 (this includes macOS's shipped /bin/bash 3.2) throws "unbound
# variable" under `set -u` when expanding "${STAGED_FILES[@]}" on a
# zero-length array — exit here, before any gate touches the array, rather
# than let a truly empty commit crash the hook on that platform.
if [ "$STAGED_COUNT" -eq 0 ]; then
  echo "SDD Pipeline Pre-Commit Check (0 files staged) — nothing to check."
  exit 0
fi

# --- Gate 1: No Hardcoded Secrets ---
check_secrets() {
  local patterns=(
    'AKIA[0-9A-Z]{16}'                          # AWS access key
    'sk-[a-zA-Z0-9]{20,}'                        # OpenAI / Stripe secret key
    'ghp_[a-zA-Z0-9]{36}'                        # GitHub personal access token
    'gho_[a-zA-Z0-9]{36}'                        # GitHub OAuth token
    'glpat-[a-zA-Z0-9\-]{20}'                    # GitLab personal access token
    'xox[bpoas]-[a-zA-Z0-9\-]+'                  # Slack token
    'sk_live_[a-zA-Z0-9]+'                       # Stripe live key
    'sq0atp-[a-zA-Z0-9\-]+'                      # Square access token
    'eyJ[a-zA-Z0-9_-]*\.eyJ[a-zA-Z0-9_-]*\.'    # JWT token
  )
  # Dropped the old bare '[0-9a-zA-Z/+]{40}' "AWS secret, loose" pattern:
  # a 40-char hex git commit SHA is a subset of that character class, so
  # any pinned dependency hash or changelog commit reference tripped it —
  # verified: it blocked this very repo's own commit that added
  # check-traceability.mjs. The prefixed patterns above (AKIA/sk-/ghp_/...)
  # already catch the real secret formats without that false-positive rate.

  for file in "${STAGED_FILES[@]}"; do
    [ -f "$file" ] || continue
    [[ "$file" == *.md ]] && continue
    [[ "$file" == *.lock ]] && continue
    [[ "$file" == *package-lock.json ]] && continue
    [[ "$file" == *yarn.lock ]] && continue

    for pattern in "${patterns[@]}"; do
      if git diff --cached -- "$file" | grep -qE "$pattern" 2>/dev/null; then
        log_error "Possible secret in $file (pattern: ${pattern:0:20}...)"
      fi
    done
  done

  # Check for common secret file names
  for file in "${STAGED_FILES[@]}"; do
    case "$file" in
      *.env|*.env.*|.env) log_error "Environment file staged: $file" ;;
      *credentials*|*secret*) log_warn "Suspicious filename: $file — verify contents" ;;
      *.pem|*.key|*.p12|*.pfx) log_error "Private key file staged: $file" ;;
    esac
  done
}

# --- Gate 2: Scope Declaration ---
check_scope() {
  if [ "$STAGED_COUNT" -gt 5 ]; then
    if [ ! -f "docs/sdd/plans/current.md" ]; then
      log_warn "Changing $STAGED_COUNT files without an SDD Pipeline plan. Consider running SDD Pipeline first."
    else
      log_ok "Plan exists for $STAGED_COUNT file changes"
    fi
  fi
}

# --- Gate 3: Security Checklist ---
check_security() {
  local auth_files=false
  for file in "${STAGED_FILES[@]}"; do
    case "$file" in
      *auth*|*login*|*password*|*session*|*token*|*payment*|*checkout*|*billing*)
        auth_files=true
        break
        ;;
    esac
  done

  if [ "$auth_files" = true ]; then
    if [ -d "docs/sdd/reports" ]; then
      local latest_report
      latest_report=$(ls -t docs/sdd/reports/*.md 2>/dev/null | head -1)
      if [ -z "$latest_report" ]; then
        log_warn "Auth/payment code changed but no SDD Pipeline security report found. Run SDD Pipeline verify."
      fi
    else
      log_warn "Auth/payment code changed. Consider running SDD Pipeline security check."
    fi
  fi
}

# --- Gate 4: Anti-Pattern Quick Scan ---
check_antipatterns() {
  for file in "${STAGED_FILES[@]}"; do
    [ -f "$file" ] || continue
    [[ "$file" == *.md ]] && continue
    [[ "$file" == *.json ]] && continue
    [[ "$file" == *.yml ]] && continue
    [[ "$file" == *.yaml ]] && continue

    local lines
    lines=$(git diff --cached -- "$file" | grep '^+' | grep -v '^+++' | wc -l || true)

    if [ "$lines" -gt 80 ]; then
      log_warn "Large addition in $file ($lines lines). Check for god function anti-pattern."
    fi
  done
}

# --- Gate 5: Test Coverage ---
check_tests() {
  local src_changed=false
  local test_changed=false

  for file in "${STAGED_FILES[@]}"; do
    case "$file" in
      *test*|*spec*|*__tests__*) test_changed=true ;;
      *.ts|*.tsx|*.js|*.jsx|*.py|*.go|*.rs|*.java|*.rb)
        [[ "$file" != *test* ]] && [[ "$file" != *spec* ]] && src_changed=true
        ;;
    esac
  done

  if [ "$src_changed" = true ] && [ "$test_changed" = false ]; then
    log_warn "Source code changed without test changes. Ensure test coverage."
  fi
}

# --- Gate 6: Decision Log ---
check_decision_log() {
  if [ "$STAGED_COUNT" -gt 10 ]; then
    local has_decision=false
    for file in "${STAGED_FILES[@]}"; do
      [[ "$file" == docs/sdd/decisions/* ]] && has_decision=true
    done
    if [ "$has_decision" = false ]; then
      log_warn "Large change ($STAGED_COUNT files) without decision log entry."
    fi
  fi
}

# --- Gate 7: Change Record ---
# Neither "the agent usually writes a changes/ file" nor "the developer
# usually remembers" is a guarantee — this runs at the git level, so it
# fires the same way whether an agent following SDD Pipeline committed this
# or a human bypassed it entirely and committed by hand. Deliberately a
# WARNING and deliberately size-gated on real source-code volume (not file
# count): a true micro fix (a real typo, a couple of lines) stays
# zero-ceremony per SDD Pipeline's own size tiers — this only speaks up once
# a change is big enough that "no record at all" starts being a real gap,
# not before. It doesn't demand a decisions/ entry (that stays Rule-of-Three
# gated) — a one-line docs/sdd/changes/ file is enough to satisfy this.
CODE_EXTENSIONS='\.(js|jsx|ts|tsx|py|go|rs|java|rb|php|c|cpp|h|hpp|cs|swift|kt)$'
check_change_record() {
  local added_lines=0
  local file
  for file in "${STAGED_FILES[@]}"; do
    [[ "$file" =~ $CODE_EXTENSIONS ]] || continue
    [[ "$file" == *test* || "$file" == *spec* ]] && continue
    local n
    n=$(git diff --cached --numstat -- "$file" 2>/dev/null | awk '{print $1+0}')
    added_lines=$((added_lines + n))
  done
  [ "$added_lines" -le 5 ] && return   # trivial diff — no nag, matches micro's zero-ceremony floor

  local has_record=false
  for file in "${STAGED_FILES[@]}"; do
    case "$file" in
      docs/sdd/changes/*|docs/sdd/plans/*|docs/sdd/decisions/*|docs/sdd/design/*|docs/sdd/tickets/*)
        has_record=true ;;
    esac
  done
  if [ "$has_record" = false ]; then
    log_warn "$added_lines source line(s) changed with no docs/sdd/{changes,plans,decisions,design,tickets} file in this commit — even a small change should leave some trace. A one-line docs/sdd/changes/ entry is enough; this applies whether an agent or a human made the commit."
  fi
}

# --- Run All Gates ---
echo "SDD Pipeline Pre-Commit Check ($STAGED_COUNT files staged)"
echo "================================================"

check_secrets
check_scope
check_security
check_antipatterns
check_tests
check_decision_log
check_change_record

echo "================================================"

if [ "$ERRORS" -gt 0 ]; then
  echo -e "${RED}BLOCKED: $ERRORS error(s), $WARNINGS warning(s)${NC}"
  echo "Fix errors before committing. Use 'git commit --no-verify' to bypass (not recommended)."
  exit 1
fi

if [ "$WARNINGS" -gt 0 ]; then
  echo -e "${YELLOW}PASSED with $WARNINGS warning(s)${NC}"
else
  echo -e "${GREEN}PASSED — all gates clear${NC}"
fi

exit 0
